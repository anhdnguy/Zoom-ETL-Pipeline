# =========================
# Global build/test artifacts
# =========================

# VCS
.git
.gitignore
.gitattributes

# Python bytecode / caches
**/__pycache__/
**/*.py[cod]
**/*$py.class

# Test / type / lint caches
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.tox/
**/.nox/
**/.hypothesis/
**/.coverage
**/coverage.xml
**/htmlcov/

# Packaging artifacts
**/*.egg-info/
**/.eggs/
**/dist/
**/build/
**/*.whl

# Virtual envs
.venv/
venv/
env/
ENV/
**/.venv/
**/venv/
**/env/

# Jupyter
**/.ipynb_checkpoints/

# Logs (including Airflow runtime logs)
**/*.log
**/logs/
airflow/logs/

# OS / editor junk
.DS_Store
Thumbs.db
**/*.swp
**/*.swo
.idea/
.vscode/
**/*.iml

# Secrets (don't bake into images)
.env
.env.*
**/*.pem
**/*.key
**/*.crt
**/*.p12
**/*.pfx

# Terraform artifacts (if present)
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/crash.log
**/*.backup

# Node artifacts (if present)
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/.next/
**/out/

# Misc temp/cache
**/tmp/
**/temp/
**/.cache/
**/*.tmp
**/*.bak

# Docker compose overrides (optional)
docker-compose.override.yml
